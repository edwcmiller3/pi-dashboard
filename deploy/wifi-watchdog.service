[Unit]
Description=Wi-Fi reconnect watchdog
After=NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=simple
# Loop body lives in wifi-watchdog.sh (installs to /usr/local/bin/) - kept out of an
# inline `sh -c` so the state check + connecting-guard aren't hostage to systemd's
# $-expansion and nested-quote rules. Mirrors the nightly-halt.sh pattern.
ExecStart=/usr/local/bin/wifi-watchdog.sh
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
